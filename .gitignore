# ==============================================================================
# éozoré Portfólio — .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# OS / Editor
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ------------------------------------------------------------------------------
# Environment variables (NUNCA commitar com valores reais)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.production
.env.development

# Credenciais e chaves privadas
*.pem
*.key
*.p12
*.json.enc
service-account*.json
*-credentials.json

# ------------------------------------------------------------------------------
# Node.js / Next.js
# ------------------------------------------------------------------------------
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# Python (caso algum script local)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
venv/
.venv/

# ------------------------------------------------------------------------------
# Firebase
# ------------------------------------------------------------------------------
.firebase/
firebase-debug.log
firestore-debug.log

# ------------------------------------------------------------------------------
# Docker
# ------------------------------------------------------------------------------
*.log
docker-compose.override.yml

# ------------------------------------------------------------------------------
# Documentos internos (não publicar)
# ------------------------------------------------------------------------------
planejamento.md
artigos.md
plano.md
apresentacao-kickoff.html
eozoreIA/

# ------------------------------------------------------------------------------
# Kiro specs (workflow interno) — .kiro/ agora é commitado (AI-DLC depende dele)
# ------------------------------------------------------------------------------
# .kiro/  ← removido: AI-DLC precisa da pasta .kiro/ versionada

# ------------------------------------------------------------------------------
# AI-DLC — cursors per-user e runtime local (NÃO commitar)
# ------------------------------------------------------------------------------
aidlc/active-space
aidlc/spaces/*/intents/active-intent
aidlc/.aidlc-clone-id
aidlc/.aidlc-turn-counter
aidlc/.aidlc-readonly-latch
aidlc/.aidlc-sessions/
aidlc/spaces/*/intents/*/runtime-graph.json
aidlc/spaces/*/intents/*/.aidlc-*

# ------------------------------------------------------------------------------
# Passo a Passo (Gerador de Motion HTML)
# ------------------------------------------------------------------------------
passoapasso/node_modules/
passoapasso/uploads/
passoapasso/temp/
passoapasso/*.zip

# ------------------------------------------------------------------------------
# Pastas de Desenvolvimento Local (Ferramentas Privadas / Rascunhos)
# ------------------------------------------------------------------------------
tool-*/

# ------------------------------------------------------------------------------
# Terraform (infra/) — providers e state NUNCA vão para o repo.
# O tfstate guarda valores de recursos em texto puro (inclusive segredos
# resolvidos), e .terraform/ são ~109MB de binários de provider.
# Os .tf continuam versionados.
# ------------------------------------------------------------------------------
**/.terraform/
*.tfstate
*.tfstate.*
tfplan*

# ------------------------------------------------------------------------------
# Artefatos de execução de teste da pipeline (saída, não fonte)
# ------------------------------------------------------------------------------
projects/test_verification_session_v3/
projects/thumbnails_test/
projects/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-*/
agents/pipeline/samples/

# Dump do Firestore (dados, não código) — exportado para inspeção local.
tool_csm/

# Log de execução local do studio.
agents/cmo_agent/studio_execution.log

# Artefato do docker-compose.local.yml, não código. O compose monta
# `agents/cmo_agent` em /app e, por cima, `infra/local/seed.py` em
# /app/seed.py. Para criar o alvo desse segundo bind mount o Docker cria um
# arquivo vazio no host — dentro de agents/cmo_agent, que é um pacote Python.
# Some ao dar `down -v`, reaparece ao subir, e volta a aparecer como untracked
# em todo `git status` de quem roda o ambiente local.
agents/cmo_agent/seed.py
