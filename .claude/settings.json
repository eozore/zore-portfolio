{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gcloud builds:*)",
      "Bash(gcloud run:*)",
      "Bash(gcloud logging:*)",
      "Bash(./scripts/deploy.sh:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gcloud run services delete:*)",
      "Bash(gcloud secrets delete:*)",
      "Bash(terraform destroy:*)"
    ]
  }
}
